# =============================================================================
# AEMS — Production Environment Variables
# =============================================================================
# Copy this file to .env.production and fill in ALL values before deploying.
# NEVER commit .env.production to version control.
#
# Generate SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# =============================================================================

# === SECURITY (REQUIRED) ===
SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_urlsafe(64))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# === DATABASE ===
POSTGRES_DB=aems_prod
POSTGRES_USER=aems_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://aems_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/aems_prod
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# === REDIS ===
REDIS_URL=redis://redis:6379/0

# === STORAGE (AWS S3 or compatible) ===
# For MinIO (self-hosted), set S3_ENDPOINT to your MinIO URL, e.g.:
#   S3_ENDPOINT=https://minio.aems.com.br
S3_BUCKET=aems-files
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# === EMAIL (SendGrid) ===
# Obtain your API key at: https://app.sendgrid.com/settings/api_keys
# FROM_EMAIL MUST be a VERIFIED sender in SendGrid (domain or single sender).
SENDGRID_API_KEY=CHANGE_ME
FROM_EMAIL=noreply@aems.com.br

# Public frontend URL (used to build email links: password reset, welcome)
FRONTEND_URL=https://CHANGE_ME

# === APP ===
APP_NAME=AEMS API
DEBUG=false
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=["https://app.aems.com.br"]

# === FIREBASE (Push Notifications — optional) ===
# Download the service account JSON from Firebase Console and place it at the
# path below inside the container (mount via Docker secret or volume).
FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json

# === DOCKER (CI/CD) ===
# Substitua SEU-USUARIO pelo seu nome de usuário no GitHub (em minúsculas)
# Esta variável é usada pelo docker-compose.prod.yml para saber qual imagem puxar
DOCKER_IMAGE=ghcr.io/SEU-USUARIO/aems-api:latest
