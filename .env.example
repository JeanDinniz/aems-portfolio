# Application
APP_NAME="AEMS API"
DEBUG=true
API_V1_PREFIX="/api/v1"

# PostgreSQL (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=aems_db

# Database
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/aems_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6380/0

# Auth - OBRIGATÓRIO: Gere uma chave secreta forte
# NUNCA use valores padrão ou compartilhe esta chave
# Para gerar: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Exemplo: SECRET_KEY=abc123XYZ_gere_sua_propria_chave_aqui_456DEF
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# MinIO (Docker)
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME

# Storage (S3/MinIO)
# ATENÇÃO: Não use credenciais padrão em produção
S3_BUCKET=aems-files
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_ENDPOINT=http://localhost:9000

# Email (SendGrid)
# Obtenha sua API key em: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
FROM_EMAIL=noreply@aems.com.br

# Firebase (opcional)
FIREBASE_CREDENTIALS_PATH=

# CORS - Defina origens permitidas (use URLs de produção em produção)
# Exemplo produção:
ALLOWED_ORIGINS=["https://app.aems.com.br"]
